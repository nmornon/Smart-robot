#include <assert.h>

typedef enum {
    POS_NORD = 0,
    POS_EST  = 1,
    POS_SUD  = 2,
    POS_OUEST= 3
} POS_Direction;

// Exemple de constantes
#define MAX_X 100
#define MAX_Y 100

// Structure Position
typedef struct {
    int x;
    int y;
    POS_Direction d;
} POS_Position;


// Fonctions Direction

POS_Direction POS_tournerDroit(POS_Direction d) {
    return (d + 1) % 4;
}

POS_Direction POS_tournerGauche(POS_Direction d) {
    return (d - 1 + 4) % 4;
}

// Constructeur et Accesseurs

POS_Position POS_creer(int x, int y, POS_Direction d) {
    assert(x >= 0 && x < MAX_X);
    assert(y >= 0 && y < MAX_Y);
    POS_Position p;
    p.x = x;
    p.y = y;
    p.d = d;
    return p;
}

int POS_getX(POS_Position p) {
    return p.x;
}

int POS_getY(POS_Position p) {
    return p.y;
}

POS_Direction POS_getDirection(POS_Position p) {
    return p.d;
}

// Rotations

POS_Position POS_rotationGauche(POS_Position p) {
    p.d = POS_tournerGauche(p.d);
    return p;
}

POS_Position POS_rotationDroit(POS_Position p) {
    p.d = POS_tournerDroit(p.d);
    return p;
}

// Avancement & Test d'égalité

POS_Position POS_avancer(POS_Position p) {
    switch (p.d) {
        case POS_NORD:
            assert(p.y < MAX_Y - 1);
            p.y++;
            break;

        case POS_SUD:
            assert(p.y > 0);
            p.y--;
            break;

        case POS_EST:
            assert(p.x < MAX_X - 1);
            p.x++;
            break;

        case POS_OUEST:
            assert(p.x > 0);
            p.x--;
            break;
    }
    return p;
}

int POS_estEgal(POS_Position p1, POS_Position p2) {
    return (p1.x == p2.x &&
            p1.y == p2.y &&
            p1.d == p2.d);
}
